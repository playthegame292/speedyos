# Maintainer: Seby <seby@speedyos>
# Artwork comes from the project's artwork/ directory (generated by
# artwork/generate-wallpapers.py), so this PKGBUILD is built in-tree by
# scripts/build-packages.sh.
pkgname=speedy-branding
pkgver=0.2.2
pkgrel=1
pkgdesc="SpeedyOS artwork and defaults: wallpapers, icons, colors, Konsole, boot splash, GRUB theme, fastfetch"
arch=('any')
url="https://github.com/sebytremblay/speedyos"
license=('GPL-2.0-or-later' 'CC-BY-SA-4.0')
depends=('plasma-workspace')
optdepends=('konsole: SpeedyOS terminal theme'
            'sddm: SpeedyOS login background'
            'plymouth: SpeedyOS boot splash'
            'grub: SpeedyOS boot menu theme'
            'fastfetch: SpeedyOS logo in fastfetch')
backup=('etc/xdg/fastfetch/config.jsonc' 'etc/xdg/kdeglobals' 'etc/xdg/konsolerc' 'etc/xdg/kscreenlockerrc' 'etc/xdg/kded5rc' 'etc/sddm.conf.d/10-speedyos.conf')
source=("SpeedyOS.colors" "SpeedyOS.colorscheme" "SpeedyOS.profile"
        "kdeglobals" "konsolerc" "kscreenlockerrc" "sddm-theme.conf.user" "kded5rc" "sddm-speedyos.conf"
        "fastfetch.jsonc" "fastfetch-logo.txt")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

_art="$startdir/../../artwork"

_wallpaper() {  # _wallpaper <id> <display name> <image basename>
    local dir="$pkgdir/usr/share/wallpapers/$1"
    install -Dm644 "$_art/wallpapers/$3-1080p.png" "$dir/contents/images/1920x1080.png"
    install -Dm644 "$_art/wallpapers/$3-4k.png" "$dir/contents/images/3840x2160.png"
    install -Dm644 /dev/stdin "$dir/metadata.json" <<EOF
{
    "KPlugin": {
        "Authors": [ { "Name": "Seby" } ],
        "Id": "$1",
        "License": "CC-BY-SA-4.0",
        "Name": "$2"
    }
}
EOF
}

package() {
    # Wallpapers. "SpeedyOS" is the default (desktop, lock screen, login).
    _wallpaper SpeedyOS "SpeedyOS Beagle Run" speedyos-speedy
    _wallpaper SpeedyOS-Paws "SpeedyOS Paws" speedyos-dark
    _wallpaper SpeedyOS-Light "SpeedyOS Light" speedyos-light
    _wallpaper SpeedyOS-Minimal "SpeedyOS Minimal" speedyos-minimal

    # Icons (badge made from the mascot photo).
    local size
    for size in 16 22 24 32 48 64 128 256 512; do
        install -Dm644 "$_art/icons/hicolor/${size}x${size}/apps/speedyos.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/speedyos.png"
    done
    install -Dm644 "$_art/icons/hicolor/256x256/apps/speedyos.png" "$pkgdir/usr/share/pixmaps/speedyos.png"
    install -Dm644 "$_art/branding/speedyos-badge.png" "$pkgdir/usr/share/speedyos/speedyos-badge.png"
    install -Dm644 "$_art/branding/speedylogo.png" "$pkgdir/usr/share/speedyos/speedy-photo.png"

    # Plasma look-and-feel + colors, made the system default via /etc/xdg.
    install -d "$pkgdir/usr/share/plasma/look-and-feel"
    cp -r --no-preserve=ownership "$startdir/lookandfeel" \
        "$pkgdir/usr/share/plasma/look-and-feel/org.speedyos.desktop"
    chmod -R u=rwX,go=rX "$pkgdir/usr/share/plasma"
    install -Dm644 "$srcdir/SpeedyOS.colors" "$pkgdir/usr/share/color-schemes/SpeedyOS.colors"
    install -Dm644 "$srcdir/kdeglobals" "$pkgdir/etc/xdg/kdeglobals"
    install -Dm644 "$srcdir/kscreenlockerrc" "$pkgdir/etc/xdg/kscreenlockerrc"
    install -Dm644 "$srcdir/kded5rc" "$pkgdir/etc/xdg/kded5rc"

    # Konsole theme and default profile.
    install -Dm644 "$srcdir/SpeedyOS.colorscheme" "$pkgdir/usr/share/konsole/SpeedyOS.colorscheme"
    install -Dm644 "$srcdir/SpeedyOS.profile" "$pkgdir/usr/share/konsole/SpeedyOS.profile"
    install -Dm644 "$srcdir/konsolerc" "$pkgdir/etc/xdg/konsolerc"

    # Login screen background for the Breeze SDDM theme (theme.conf.user is
    # the documented per-system override file, not owned by any package).
    install -Dm644 "$srcdir/sddm-theme.conf.user" "$pkgdir/usr/share/sddm/themes/breeze/theme.conf.user"
    install -Dm644 "$srcdir/sddm-speedyos.conf" "$pkgdir/etc/sddm.conf.d/10-speedyos.conf"

    # Boot splash and boot menu (artwork/generate-boot-art.py). The installer
    # selects them; nothing here changes the boot setup on its own.
    local f
    for f in "$_art"/plymouth/speedyos/*; do
        install -Dm644 "$f" "$pkgdir/usr/share/plymouth/themes/speedyos/${f##*/}"
    done
    for f in "$_art"/grub/speedyos/*; do
        install -Dm644 "$f" "$pkgdir/usr/share/grub/themes/speedyos/${f##*/}"
    done

    # fastfetch: beagle logo and "SpeedyOS" OS line for everyone.
    install -Dm644 "$srcdir/fastfetch.jsonc" "$pkgdir/etc/xdg/fastfetch/config.jsonc"
    install -Dm644 "$srcdir/fastfetch-logo.txt" "$pkgdir/usr/share/speedyos/fastfetch-logo.txt"
}
