    def launch_installer(self):
        if not self.is_live:
            QMessageBox.information(self, "SpeedyOS", "SpeedyOS is already installed on this computer.")
            return

        launcher = shutil.which("speedyos-installer") or "/usr/local/bin/speedyos-installer"
        if not os.access(launcher, os.X_OK) or not shutil.which("calamares"):
            QMessageBox.warning(self, "Installer Not Found",
                                "The SpeedyOS installer (Calamares) is not available in this image.")
            return

        try:
            subprocess.Popen([launcher])
        except OSError as e:
            QMessageBox.critical(self, "Error Launching Installer", str(e))

    def pet_speedy(self):
        """Easter egg: pet the logo a few times."""
        self.logo_clicks += 1
        if self.logo_clicks % 5 == 0:
            bark = BARKS[(self.logo_clicks // 5 - 1) % len(BARKS)]
            QMessageBox.information(self, "Speedy", f"{bark}\n\nYou pet Speedy {self.logo_clicks} times.")

    def eventFilter(self, obj, event):
        """Easter egg: the Konami code makes Speedy dance in a terminal."""
        if event.type() == QEvent.KeyPress and not event.isAutoRepeat():
            self.keys = (self.keys + [event.key()])[-len(KONAMI):]
            if self.keys == KONAMI:
                self.keys = []
                QMessageBox.information(self, "Speedy", "Konami code accepted.\nSpeedy is warming up the dance floor...")
                self.run_terminal_command("speedy dance")
        return super().eventFilter(obj, event)

    def launch_update(self):
        self.run_terminal_command("speedy update; echo; read -rp 'Press Enter to close...'")

    def toggle_autostart(self, enabled):
        try:
            set_autostart(enabled)
        except OSError as e:
            QMessageBox.warning(self, "SpeedyOS", f"Could not change the startup setting:\n{e}")

    def open_url(self, url):
        if not self.run_command_args(["xdg-open", url]):
            QMessageBox.information(self, "SpeedyOS", f"Open this address in a browser:\n{url}")

    def run_command(self, cmd):
        """Launch a fixed program command line (never user input)."""
        self.run_command_args(shlex.split(cmd))

    def run_command_args(self, args):
        if not shutil.which(args[0]):
            QMessageBox.warning(self, "Not Installed",
                                f"'{args[0]}' is not installed on this system.\n"
                                f"Install it with: speedy install <package>")
            return False
        try:
            subprocess.Popen(args, start_new_session=True)
            return True
        except OSError as e:
            QMessageBox.warning(self, "Launch Error", f"Could not start {args[0]}:\n{e}")
            return False

    def run_terminal_command(self, cmd):
        """Run a fixed shell snippet in a terminal window."""
        for term in (["konsole", "-e"], ["xterm", "-e"]):
            if shutil.which(term[0]):
                self.run_command_args(term + ["bash", "-c", cmd])
                return
        QMessageBox.warning(self, "No Terminal", "No terminal application (Konsole) was found.")

