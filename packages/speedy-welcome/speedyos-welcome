def read_kv_file(path):
    """Parse a shell-style KEY="value" file such as /etc/os-release."""
    data = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                try:
                    data[key] = " ".join(shlex.split(value))
                except ValueError:
                    data[key] = value.strip('"')
    except OSError:
        pass
    return data


def user_autostart_file():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "autostart", AUTOSTART_NAME)


def autostart_enabled():
    """The package ships /etc/xdg/autostart; a user copy with Hidden=true disables it."""
    data = read_kv_file(user_autostart_file())
    return data.get("Hidden", "false").lower() != "true"


def set_autostart(enabled):
    path = user_autostart_file()
    if enabled:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("[Desktop Entry]\nType=Application\nName=SpeedyOS Welcome Center\n"
                "Exec=speedyos-welcome\nHidden=true\n")

def is_live_environment():
    """Detect if running in live ISO or an installed system"""
    indicators = [
        "/run/archiso/bootmnt",
        "/run/speedyos/bootmnt",
        "/run/archiso",
        "/run/speedyos"
    ]
    return any(os.path.exists(path) for path in indicators)

def find_logo():
    """Find the SpeedyOS logo image"""
    candidates = [
        "/usr/share/pixmaps/speedyos.png",
        "/usr/share/icons/hicolor/256x256/apps/speedyos.png",
        os.path.join(os.path.dirname(__file__), "../../artwork/branding/speedylogo.png"),
        os.path.join(os.path.dirname(__file__), "../../artwork/icons/speedyos.png"),
    ]
    for path in candidates:
        if os.path.exists(path):
            return path
    return ""

