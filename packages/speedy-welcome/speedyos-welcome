    def system_info_html(self):
        osr = read_kv_file("/etc/os-release")
        spr = read_kv_file("/etc/speedyos-release")
        uname = platform.uname()
        mem = ""
        try:
            with open("/proc/meminfo") as f:
                kb = int(next(l for l in f if l.startswith("MemTotal")).split()[1])
            mem = f"{kb / 1024 / 1024:.1f} GiB"
        except (OSError, StopIteration, ValueError):
            mem = "unknown"
        cpu = "unknown"
        try:
            with open("/proc/cpuinfo") as f:
                cpu = next(l for l in f if l.startswith("model name")).split(":", 1)[1].strip()
        except (OSError, StopIteration):
            pass
        session = os.environ.get("XDG_SESSION_TYPE", "unknown")
        desktop = os.environ.get("XDG_CURRENT_DESKTOP", "unknown")
        version = spr.get("SPEEDYOS_VERSION", "unknown")
        codename = spr.get("SPEEDYOS_CODENAME", "")
        rows = [
            ("SpeedyOS", f"{version} “{codename}”" if codename else version),
            ("Base", osr.get("PRETTY_NAME", "Arch Linux")),
            ("Mode", "Live session" if self.is_live else "Installed system"),
            ("Desktop", f"{desktop} ({session})"),
            ("Kernel", uname.release),
            ("Architecture", uname.machine),
            ("Host name", uname.node),
            ("CPU", cpu),
            ("Memory", mem),
        ]
        body = "".join(f"<tr><td><b>{k}</b></td><td>{v}</td></tr>" for k, v in rows)
        return f"""<h3 style="color: #c97d3e;">🐾 SpeedyOS</h3>
        <table cellpadding="6">{body}</table>"""

