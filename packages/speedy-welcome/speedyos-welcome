def main():
    # In the live session the "Try or Install" screen greets the user
    # instead; the Welcome Center stays one click away on the desktop.
    if "--autostart" in sys.argv[1:] and is_live_environment():
        return
    app = QApplication(sys.argv)
    window = SpeedyWelcomeApp()
    app.installEventFilter(window)
    window.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
