# Rainbow palettes: 256-color (lolcat-style) and the 6 basic ANSI colors for
# the Linux console.
RAINBOW_256=(196 202 208 214 220 226 190 154 118 82 46 47 48 49 50 51
             45 39 33 27 21 57 93 129 165 201 200 199 198 197)
RAINBOW_16=(31 33 32 36 34 35)

# Print one line in rainbow colors. $1 = text, $2 = color phase.
rainbow_line() {
    local text=$1 phase=$2 out='' ch i n code
    if [[ -z $NC ]]; then printf '%s' "$text"; return; fi
    if [[ ${TERM:-} == linux ]]; then n=${#RAINBOW_16[@]}; else n=${#RAINBOW_256[@]}; fi
    for (( i = 0; i < ${#text}; i++ )); do
        ch=${text:i:1}
        if [[ $ch == ' ' ]]; then out+=' '; continue; fi
        if [[ ${TERM:-} == linux ]]; then
            code="1;${RAINBOW_16[( (i / 3 + phase) % n )]}"
        else
            code="1;38;5;${RAINBOW_256[( (i / 2 + phase) % n )]}"
        fi
        out+=$'\e['"${code}m${ch}"
    done
    printf '%s%s' "$out" "$NC"
}

# Build dance frame $1 (0-3) into the DANCE_FRAME array.
dance_frame() {
    local -n arms legs
    case $1 in
        0) arms=DANCE_ARMS_UU legs=DANCE_LEGS_N ;;
        1) arms=DANCE_ARMS_UD legs=DANCE_LEGS_R ;;
        2) arms=DANCE_ARMS_DD legs=DANCE_LEGS_N ;;
        3) arms=DANCE_ARMS_DU legs=DANCE_LEGS_L ;;
    esac
    DANCE_FRAME=("${DANCE_HEAD[@]}" "${arms[@]}" "${legs[@]}")
    # Wink on the third beat.
    (( $1 == 2 )) && DANCE_FRAME[3]=${DANCE_FRAME[3]/'[(o)]--[(o)]'/'[(o)]--[(-)]'}
}

cmd_dance() {
    local seconds=${1:-0}
    [[ $seconds =~ ^[0-9]+$ ]] || die "Usage: speedy dance [seconds]  (default: until you press a key)"

    # Not a terminal (pipe, file): one still frame, no escape codes.
    if [[ ! -t 1 || ! -t 0 ]]; then
        dance_frame 0
        printf '%s\n' "${DANCE_FRAME[@]}"
        echo "  Speedy is dancing. (Run it in a terminal to see the moves.)"
        return 0
    fi

    local rows cols
    read -r rows cols < <(stty size 2>/dev/null || echo '24 80')
    local captions=('~ beagle boogie ~' '~ paws in the air ~' '~ wiggle wiggle ~'
                    '~ zoomies mode ~' '~ who let the dog out ~' '~ fast paws ~')
    local sways=(4 6 4 2) floor='=-' tick=0 start=$SECONDS key
    local height=$(( ${#DANCE_HEAD[@]} + ${#DANCE_ARMS_UU[@]} + ${#DANCE_LEGS_N[@]} + 5 ))
    local top=$(( rows > height ? (rows - height) / 2 : 0 ))
    local left=$(( cols > 40 ? (cols - 40) / 2 : 0 ))
    local pad
    printf -v pad '%*s' "$left" ''

    # Alternate screen, hidden cursor; always restored, even on Ctrl+C.
    local saved_stty
    saved_stty=$(stty -g)
    trap 'printf "\e[?25h\e[?1049l"; stty "$saved_stty"; trap - INT TERM EXIT' EXIT
    trap 'exit 0' INT TERM
    stty -echo -icanon
    printf '\e[?1049h\e[?25l\e[2J'

    local f line i out sway
    while :; do
        f=$(( tick % 4 ))
        dance_frame "$f"
        sway=${sways[f]}
        out=$'\e[H'
        for (( i = 0; i < top; i++ )); do out+=$'\e[K\n'; done
        out+="$pad"$'\e[K'$(rainbow_line "$(printf '%*s' $(( 10 + (tick % 2) * 2 )) '')${captions[(tick / 4) % ${#captions[@]}]}" "$tick")$'\n\e[K\n'
        for line in "${DANCE_FRAME[@]}"; do
            out+="$pad"$'\e[K'"$(rainbow_line "$(printf '%*s' "$sway" '')$line" "$(( tick + i++ ))")"$'\n'
        done
        if (( tick % 2 )); then floor='-='; else floor='=-'; fi
        out+="$pad"$'\e[K'"$(rainbow_line "$(printf "%0.s$floor" {1..18})" "$tick")"$'\n\e[K\n'
        out+="$pad"$'\e[K'"${BOLD}Speedy is dancing.${NC} Press any key to stop."$'\e[J'
        printf '%s' "$out"
        (( tick++ ))
        if (( seconds > 0 && SECONDS - start >= seconds )); then break; fi
        if read -rsn1 -t 0.12 key; then break; fi
    done
    exit 0
}

