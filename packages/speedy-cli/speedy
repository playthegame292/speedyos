# A small beagle (with glasses) runs across the terminal.
zoomies() {
    local -a a=('             .--.  ' '  -=-\_____/ o-o\_ ' '  -=-(        __O)' '      / /  \ \    ')
    local -a b=('             .--.  ' ' =-=-\_____/ o-o\_ ' ' =-=-(        __O)' '     \ \    / /   ')
    if [[ ! -t 1 ]]; then printf '%s\n' "${a[@]}"; return; fi
    local cols x i
    cols=$(stty size 2>/dev/null </dev/tty | cut -d' ' -f2)
    cols=${cols:-80}
    printf '\e[?25l'
    for (( x = 0; x < cols - 20; x += 3 )); do
        local -a spr=("${a[@]}")
        (( (x / 3) % 2 )) && spr=("${b[@]}")
        for i in 0 1 2 3; do printf '\r\e[K%*s%s\n' "$x" '' "${BROWN}${spr[i]}${NC}"; done
        printf '\e[4A'
        sleep 0.04
    done
    printf '\e[4B\r\e[?25h'
}

