treat_file() { printf '%s/speedy/treats' "${XDG_STATE_HOME:-$HOME/.local/state}"; }

cmd_treat() {
    local file count=0
    file=$(treat_file)
    [[ -r $file ]] && read -r count <"$file"
    [[ $count =~ ^[0-9]+$ ]] || count=0
    (( count++ ))
    mkdir -p -- "${file%/*}" && printf '%s\n' "$count" >"$file"
    case $count in
        1)   paw "Speedy gobbles the treat. Speedy loves you now. Forever." ;;
        2|3) paw "Treat #${count}. Tail is wagging at maximum speed." ;;
        10)  paw "Treat #10! Speedy is a very round beagle now. Maybe a walk?" ;;
        42)  paw "Treat #42. The answer to life, the universe and snacks." ;;
        100) paw "Treat #100. Speedy has achieved snack enlightenment." ;;
        *)   paw "Treat #${count}. Speedy would like another one, please." ;;
    esac
}

