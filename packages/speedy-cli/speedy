    cat <<EOF
${BROWN}${G_PAW} Speedy's tricks${NC}

    speedy dance     rainbow dance party (press a key to stop)
    speedy bark      say something
    speedy sit       sit
    speedy stay      try to stay
    speedy roll      roll over
    speedy fetch     fetch something from your system
    speedy treat     give Speedy a treat (Speedy keeps count)
    speedy zoomies   run around very fast
    speedy wisdom    beagle wisdom

There are a few more. Good dogs sniff them out.
EOF
}

# Special days, shown by "speedy help".
special_day() {
    case $(date +%m-%d) in
        08-26) paw "Happy International Dog Day! Give a good dog a treat: speedy treat" ;;
        10-31) paw "Happy Halloween! Speedy is dressed as a slightly larger beagle." ;;
        04-01) paw "Speedy is now a cat. Meow. (Just kidding. Woof.)" ;;
        12-25) paw "Merry Christmas! Speedy already opened all the presents. Sorry." ;;
    esac
}

# -------------------------------------------------------------- dispatch ---

main() {
    (( $# > 0 )) || { cmd_help; exit 0; }
    local command=$1; shift
    case $command in
        help|--help|-h)       cmd_help ;;
        version|--version|-V) cmd_version ;;
        info)                 cmd_info ;;
        update|upgrade)       cmd_update "$@" ;;
        install)              cmd_install "$@" ;;
        remove|uninstall)     cmd_remove "$@" ;;
        search)               cmd_search "$@" ;;
        doctor)               cmd_doctor ;;
        clean)                cmd_clean ;;
        apps)                 cmd_apps ;;
        welcome)              cmd_welcome ;;
        installer)            cmd_installer ;;
        dance|boogie|party)   cmd_dance "$@" ;;
        tricks)               cmd_tricks ;;
        bark|woof)            cmd_bark ;;
        treat|snack)          cmd_treat ;;
        wisdom|fortune)       cmd_wisdom ;;
        fetch)                cmd_fetch ;;
        sit)                  cmd_sit ;;
        stay)                 cmd_stay ;;
        roll|rollover)        cmd_roll ;;
        zoomies|run)          cmd_zoomies ;;
        squirrel)             cmd_squirrel ;;
        moo)                  cmd_moo ;;
        goodboy|gooddog|good) cmd_goodboy ;;
        pet)                  paw "Speedy leans into your hand. Tail: wagging." ;;
        sudo)                 paw "Speedy does not need sudo. Speedy has root on the couch." ;;
        meow)                 paw "...Speedy stares at you, deeply confused." ;;
        *) error "Unknown command: ${command}"; echo "Run 'speedy help' for the list of commands." >&2; exit 2 ;;
    esac
}

main "$@"
