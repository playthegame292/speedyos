#!/usr/bin/env bash
# SpeedyOS Command-Line Utility
# Friendly wrapper for common system tasks. Every command maps to a normal
# Arch tool (pacman, systemctl, ...) and prints what it is about to run.
# Fast Paws. Arch Power.

set -uo pipefail

VERSION="0.3.0"

# ---------------------------------------------------------------- output ---

# Colors only on a terminal, and never when NO_COLOR is set (no-color.org).
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    RED=$'\e[0;31m' GREEN=$'\e[0;32m' YELLOW=$'\e[1;33m' BLUE=$'\e[0;34m'
    BROWN=$'\e[38;5;172m' BOLD=$'\e[1m' NC=$'\e[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' BROWN='' BOLD='' NC=''
fi

# Glyphs need a UTF-8 locale and a terminal that can draw them; the Linux
# console (TERM=linux) can't, so fall back to plain ASCII there.
if [[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} == *[Uu][Tt][Ff]* && ${TERM:-} != linux ]]; then
    G_OK='✓' G_ERR='✗' G_WARN='!' G_INFO='i' G_PAW='🐾'
else
    G_OK='ok' G_ERR='x' G_WARN='!' G_INFO='i' G_PAW='*'
fi

error()   { printf '%s%s Error: %s%s\n' "$RED" "$G_ERR" "$*" "$NC" >&2; }
die()     { error "$@"; exit 1; }
warning() { printf '%s%s %s%s\n' "$YELLOW" "$G_WARN" "$*" "$NC" >&2; }
success() { printf '%s%s %s%s\n' "$GREEN" "$G_OK" "$*" "$NC"; }
info()    { printf '%s%s %s%s\n' "$BLUE" "$G_INFO" "$*" "$NC"; }
paw()     { printf '%s%s %s%s\n' "$BROWN" "$G_PAW" "$*" "$NC"; }

# --------------------------------------------------------------- helpers ---

check_pacman() {
    command -v pacman >/dev/null 2>&1 || die "pacman not found. Is this an Arch-based system?"
}

# Run a command as root: directly if we are root, otherwise through sudo.
# The command is passed as an argument vector; nothing is ever eval'd.
as_root() {
    if (( EUID == 0 )); then
        "$@"
    else
        command -v sudo >/dev/null 2>&1 || die "sudo is not installed; run this command as root."
        sudo -- "$@"
    fi
}

# Show the exact command line before running it.
show_cmd() {
    local prefix=''
    (( EUID == 0 )) || prefix='sudo '
    printf '%s  $ %s%s%s\n' "$BOLD" "$prefix" "$*" "$NC"
}

# Package names per Arch rules: lowercase alphanumerics and @._+-,
# not starting with '-' or '.'. This also stops arguments from being
# interpreted as pacman options.
validate_pkgs() {
    local verb=$1; shift
    (( $# > 0 )) || die "No package specified. Usage: speedy ${verb} <package> [package...]"
    local p
    for p in "$@"; do
        [[ $p =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ ]] \
            || die "'${p}' is not a valid package name."
    done
}

confirm() {
    local reply
    [[ -t 0 ]] || die "Confirmation needed but no terminal is attached."
    read -r -p "$1 [y/N] " reply
    [[ $reply =~ ^[Yy]([Ee][Ss])?$ ]]
}

is_live() { [[ -d /run/archiso ]]; }

have_display() { [[ -n ${WAYLAND_DISPLAY:-} || -n ${DISPLAY:-} ]]; }

speedyos_release() {
    local f=/etc/speedyos-release
    if [[ -r $f ]]; then
        # shellcheck disable=SC1090
        ( . "$f"; printf '%s' "${SPEEDYOS_VERSION:-unknown} \"${SPEEDYOS_CODENAME:-}\"" )
    else
        printf 'unknown'
    fi
}

# -------------------------------------------------------------- commands ---

cmd_help() {
    cat <<EOF
${BROWN}${G_PAW} SpeedyOS commands${NC}

USAGE
    speedy <command> [arguments]

PACKAGES
    update              Full system upgrade (pacman -Syu)
    install <pkg...>    Install packages from the Arch repositories
    remove <pkg...>     Remove packages (asks for confirmation first)
    search <term...>    Search the repositories
    clean               Trim the package cache (keeps 2 versions)
    apps                Suggested applications

SYSTEM
    info                System and SpeedyOS information
    doctor              Health check with suggestions
    version             Version information

DESKTOP
    welcome             Open the SpeedyOS Welcome Center
    installer           Start the installer (live session only)

FUN
    dance [seconds]     Speedy (in glasses) dances in rainbow colors
    tricks              Other things Speedy can do

    help                Show this help

EXAMPLES
    speedy update
    speedy install firefox
    speedy search chromium

speedy only calls standard tools (pacman, systemctl, ...); it shows the
exact command it runs, so you can always do the same thing by hand.

${G_PAW} Fast Paws. Arch Power.
EOF
    special_day
}

cmd_version() {
    echo "speedy ${VERSION}"
    echo "SpeedyOS $(speedyos_release)"
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        ( . /etc/os-release; echo "Base: ${PRETTY_NAME:-$NAME}" )
    fi
    echo "Kernel: $(uname -r)"
}

cmd_info() {
    local host mem cpu cores disk de
    host=$(cat /proc/sys/kernel/hostname 2>/dev/null || uname -n)
    printf '%s%s SpeedyOS %s%s\n\n' "$BROWN$BOLD" "$G_PAW" "$(speedyos_release)" "$NC"
    printf '%-14s %s\n' "Mode:" "$(is_live && echo 'Live session' || echo 'Installed system')"
    [[ -r /etc/os-release ]] && printf '%-14s %s\n' "Base:" "$(. /etc/os-release; echo "${PRETTY_NAME:-$NAME}")"
    printf '%-14s %s\n' "Kernel:" "$(uname -r)"
    printf '%-14s %s\n' "Architecture:" "$(uname -m)"
    printf '%-14s %s\n' "Hostname:" "$host"
    printf '%-14s %s\n' "Uptime:" "$(uptime -p 2>/dev/null || echo unknown)"
    de=${XDG_CURRENT_DESKTOP:-none}
    [[ -n ${XDG_SESSION_TYPE:-} ]] && de+=" (${XDG_SESSION_TYPE})"
    printf '%-14s %s\n' "Desktop:" "$de"
    cpu=$(awk -F': ' '/^model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null)
    cores=$(nproc 2>/dev/null || echo '?')
    printf '%-14s %s\n' "CPU:" "${cpu:-unknown} (${cores} threads)"
    mem=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3 " / " $2}')
    printf '%-14s %s\n' "Memory:" "${mem:-unknown}"
    disk=$(df -h / 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $5 " used)"}')
    printf '%-14s %s\n' "Disk (/):" "${disk:-unknown}"
    if command -v pacman >/dev/null 2>&1; then
        printf '%-14s %s\n' "Packages:" "$(pacman -Qq | wc -l)"
    fi
    echo
    paw "Fast Paws. Arch Power."
}

cmd_update() {
    check_pacman
    (( $# == 0 )) || die "update takes no arguments."
    paw "Updating SpeedyOS (full Arch system upgrade)..."
    show_cmd pacman -Syu
    as_root pacman -Syu || die "Update did not complete (pacman exit code $?)."
    success "System is up to date."
}

cmd_install() {
    check_pacman
    validate_pkgs install "$@"
    paw "Installing: $*"
    show_cmd pacman -S --needed "$@"
    as_root pacman -S --needed -- "$@" || die "Installation did not complete. Try 'speedy update' first if packages were not found."
    success "Installed: $*"
}

cmd_remove() {
    check_pacman
    validate_pkgs remove "$@"
    local p missing=()
    for p in "$@"; do
        pacman -Qq -- "$p" >/dev/null 2>&1 || missing+=("$p")
    done
    (( ${#missing[@]} == 0 )) || die "Not installed: ${missing[*]}"

    warning "This removes: $*"
    info "Dependencies that nothing else needs are removed too (pacman -Rs)."
    info "Your personal files and settings in your home folder are not touched."
    confirm "Remove these packages?" || { info "Cancelled; nothing was removed."; exit 0; }
    show_cmd pacman -Rs "$@"
    as_root pacman -Rs -- "$@" || die "Removal did not complete."
    success "Removed: $*"
}

cmd_search() {
    check_pacman
    (( $# > 0 )) || die "No search term. Usage: speedy search <term>"
    local t
    for t in "$@"; do
        [[ $t != -* ]] || die "Search terms cannot start with '-'."
    done
    paw "Searching for: $*"
    pacman -Ss -- "$@" || info "No packages found. Repository data may be old: try 'speedy update'."
}

cmd_doctor() {
    local issues=0 n
    paw "Speedy doctor: checking your system..."
    echo

    info "Package database"
    if ! command -v pacman >/dev/null 2>&1; then
        warning "pacman is missing"; issues=$((issues + 1))
    elif pacman -Dk >/dev/null 2>&1; then
        success "Package database is consistent"
    else
        warning "Package database has problems. Details: pacman -Dk"
        issues=$((issues + 1))
    fi

    if [[ -e /var/lib/pacman/db.lck ]] && ! pgrep -x pacman >/dev/null 2>&1; then
        warning "Stale pacman lock (/var/lib/pacman/db.lck) but pacman is not running."
        info "  If no update is running: sudo rm /var/lib/pacman/db.lck"
        issues=$((issues + 1))
    fi

    info "System services"
    n=$(systemctl --failed --no-legend --plain 2>/dev/null | grep -c .)
    if (( n == 0 )); then
        success "No failed services"
    else
        warning "${n} failed service(s):"
        systemctl --failed --no-legend --plain 2>/dev/null | sed 's/^/    /'
        info "  Inspect one with: journalctl -b -u <service>"
        issues=$((issues + 1))
    fi

    info "Disk space"
    n=$(df --output=pcent / 2>/dev/null | tail -1 | tr -dc '0-9')
    if [[ -z $n ]]; then
        warning "Could not read disk usage"
    elif (( n < 90 )); then
        success "Root filesystem ${n}% used"
    else
        warning "Root filesystem ${n}% used. 'speedy clean' frees package cache."
        issues=$((issues + 1))
    fi

    info "Orphaned packages"
    n=$(pacman -Qtdq 2>/dev/null | grep -c .)
    if (( n == 0 )); then
        success "No orphaned packages"
    else
        warning "${n} package(s) installed as dependencies but no longer needed."
        info "  Review: pacman -Qtd    Remove: sudo pacman -Rns \$(pacman -Qtdq)"
    fi

    info "Network"
    if command -v nmcli >/dev/null 2>&1 && [[ $(nmcli -t -f STATE general 2>/dev/null) != connected* ]]; then
        warning "NetworkManager reports no connection. Connect via the network icon or 'nmtui'."
        issues=$((issues + 1))
    elif getent ahosts archlinux.org >/dev/null 2>&1; then
        success "DNS works (archlinux.org resolves)"
    else
        warning "Cannot resolve archlinux.org. Check your connection."
        issues=$((issues + 1))
    fi

    if ! is_live; then
        info "Updates"
        if command -v checkupdates >/dev/null 2>&1; then
            n=$(checkupdates 2>/dev/null | grep -c .)
            if (( n == 0 )); then
                success "No pending updates (or repositories unreachable)"
            else
                warning "${n} update(s) available. Run: speedy update"
            fi
        else
            info "  Skipped: install pacman-contrib for the update check."
        fi
    fi

    echo
    if (( issues == 0 )); then
        paw "All good. Good dog."
    else
        paw "${issues} issue(s) need attention (see above)."
    fi
    (( issues == 0 ))
}

cmd_clean() {
    check_pacman
    if command -v paccache >/dev/null 2>&1; then
        warning "Removes cached package files, keeping the 2 newest versions of each."
        info "Installed software is not affected."
        paccache -dk2 2>/dev/null | tail -n 1
        confirm "Clean the package cache?" || { info "Cancelled."; exit 0; }
        show_cmd paccache -rk2
        as_root paccache -rk2
        show_cmd paccache -ruk0
        as_root paccache -ruk0
    else
        warning "paccache (pacman-contrib) not found; using pacman -Sc instead."
        info "That removes cached files of packages that are no longer installed."
        show_cmd pacman -Sc
        as_root pacman -Sc
    fi
    success "Package cache cleaned."
}

